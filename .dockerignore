# =====================================================================
# AI-MIMS (AI Mining Inspection and Monitoring System) - .dockerignore
# =====================================================================

# Version control
.git
.gitignore

# Virtual environments
venv
.venv
env
ENV
env.bak
venv.bak

# Python caches and compiled bytecode
__pycache__
*.py[cod]
*$py.class
*.so
.pytest_cache

# Node / frontend local artifacts
node_modules
frontend/node_modules
frontend/dist
frontend/.vite

# Environment variables, credentials and secrets
.env
.env.*
*.pem
*.key
*.cert
*.pfx

# SQLite database files and lock/journal files
*.db
*.sqlite
*.sqlite3
backend/app/data/*.db
backend/app/data/*.db-journal
backend/app/data/*.db-wal
backend/app/data/*.db-shm

# Generated inspection reports & uploads (preserve structure via gitkeep)
backend/app/data/reports/*
!backend/app/data/reports/.gitkeep
backend/app/data/uploads/*
!backend/app/data/uploads/.gitkeep
backend/app/data/sample_imagery/*
!backend/app/data/sample_imagery/.gitkeep

# Logs
*.log
logs
npm-debug.log*
yarn-debug.log*

# IDE and OS artifacts
.idea
.vscode
.DS_Store
Thumbs.db
desktop.ini
